# === Dependências (cada ambiente instala pelo package-lock) ===
node_modules/

# === Arquivos de ambiente / segredos ===
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/env.example

# === Uploads em runtime (cada ambiente tem o seu) ===
backend/uploads/

# === Build do React ===
# Versionamos `dist-ui/` porque o cPanel/TurboCloud (Node Selector via
# Passenger) não roda build automático no deploy. Rode `npm run build`
# localmente antes de cada push pra manter o bundle atualizado no repo.
# (Se mudar pra um host que roda build no servidor, basta descomentar
#  a linha abaixo.)
# dist-ui/

# === Logs ===
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# === Coverage / testes ===
coverage/
.nyc_output/

# === Editores / OS ===
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# === Cache de ferramentas ===
.cache/
.parcel-cache/
.eslintcache
.turbo/
