# =========================================================================
# Rota++ — Variáveis de ambiente
# Copie para backend/.env (dev) ou backend/.env.production (homologação/prod)
# e preencha. Nunca commite arquivos .env reais.
# =========================================================================

# --- Banco de dados MySQL ---------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Servidor HTTP ----------------------------------------------------------
# PORT: TurboCloud injeta automaticamente. Em dev deixe 3000.
PORT=3000
# HOST: 0.0.0.0 obrigatório em container/hospedagem; 127.0.0.1 só em dev local.
HOST=0.0.0.0
# URL pública (exibida em logs e usada em scripts). Ex: https://rota.seudominio.com
PUBLIC_URL=http://localhost:3000

# --- Autenticação -----------------------------------------------------------
# JWT_SECRET: string longa e aleatória. Gere com: openssl rand -hex 48
JWT_SECRET=troque-por-string-longa-e-aleatoria
JWT_EXPIRES_IN=7d

# Login Master SaaS (tela /master/index.html). Comparado em texto plano com o corpo do login.
MASTER_USER=
MASTER_PASS=
# Gerar senha aleatória: na raiz do projeto rode → npm run senha-master

# --- CORS -------------------------------------------------------------------
# Lista separada por vírgula dos domínios que podem chamar /api/*.
# Em produção aponte SOMENTE para o domínio público real.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- Integrações externas ---------------------------------------------------
# Fallback da chave OpenRouteService quando a empresa não tiver `api_mapas`.
ORS_KEY=

# --- Ambiente ---------------------------------------------------------------
NODE_ENV=development
